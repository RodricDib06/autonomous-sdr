# AutonomousSDR Configuration

# Database
DATABASE_URL=postgresql://sdr_user:sdrpassword@localhost:5433/sdr_db

# Redis Queue
REDIS_URL=redis://localhost:6379

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Application
APP_ENV=development

# ICP (Ideal Customer Profile) Settings
ICP_MIN_COMPANY_SIZE=50
ICP_MAX_COMPANY_SIZE=500
ICP_INDUSTRIES=SaaS,Technology,Software,FinTech,DevTools
ICP_MIN_SENIORITY=Manager

# Authentication (Phase 3)
# Generate a strong SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
INITIAL_ADMIN_EMAIL=admin@yourcompany.com
INITIAL_ADMIN_PASSWORD=change-me-on-first-login
