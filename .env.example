# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sdr_user:sdrpassword@localhost:5432/sdr_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Options:
#   ollama  — default, free, local (requires: ollama serve && ollama pull mistral)
#   groq    — free tier 6 000 req/h, fast (sign up: https://console.groq.com)
#   claude  — production quality (sign up: https://console.anthropic.com)
AI_PROVIDER=groq

# Ollama — used when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Groq — used when AI_PROVIDER=groq
# Free tier: 6 000 req/h, 500 000 tok/min — no credit card required
# Models: llama-3.1-70b-versatile (default) | llama-3.3-70b-specdec | mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Anthropic Claude — used when AI_PROVIDER=claude
# claude-sonnet-4-6 recommended; claude-haiku-4-5-20251001 for high-volume / lower cost
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Web Search (ResearchAgent tool) ───────────────────────────────────────────
# Tavily — used by the ReAct ResearchAgent for real-time web search
# Free tier: 1 000 searches/month — no credit card required
# Sign up: https://tavily.com
# Without a key, DuckDuckGo is used automatically as a free fallback (no sign-up)
TAVILY_API_KEY=

# ─── Enrichment Provider ───────────────────────────────────────────────────────
# Options: synthetic (default, free, heuristic) | hunter (real company data)
ENRICHMENT_PROVIDER=synthetic

# Hunter.io — used when ENRICHMENT_PROVIDER=hunter
# Free tier: 25 domain lookups / month — enough for demos
# Get a key at: https://hunter.io/api-keys
HUNTER_API_KEY=

# ─── ICP Configuration ─────────────────────────────────────────────────────────
ICP_MIN_COMPANY_SIZE=50
ICP_MAX_COMPANY_SIZE=500
ICP_INDUSTRIES=SaaS,Technology,Software,FinTech,DevTools
ICP_MIN_SENIORITY=Manager

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
INITIAL_ADMIN_EMAIL=admin@yourcompany.com
INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# ─── Notifications (optional) ──────────────────────────────────────────────────
# Configure via API after startup: POST /config/slack?webhook_url=...
SLACK_WEBHOOK_URL=

# ─── Outreach / SMTP ──────────────────────────────────────────────────────────
# PoC: Gmail SMTP (free, 500 emails/day)
# 1. Enable 2FA on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Fill in the values below
# PRODUCTION: swap for SendGrid / Mailgun relay — change only SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
OUTREACH_FROM_EMAIL=your@gmail.com
OUTREACH_SENDER_NAME=Your Name

# ─── Outreach guardrails (compliance & deliverability) ────────────────────────
# Hard cap on emails sent in any rolling 24h window — protects sender reputation
OUTREACH_DAILY_SEND_LIMIT=200
# Quiet hours: only send between these hours (UTC, 24h clock)
OUTREACH_SEND_WINDOW_START=8
OUTREACH_SEND_WINDOW_END=18
# Skip Saturday/Sunday sends
OUTREACH_WEEKDAYS_ONLY=true

# ─── Booking — Cal.com ────────────────────────────────────────────────────────
# Free at https://cal.com — create an account and event type, then copy the URL
# Self-hosted: https://github.com/calcom/cal.com
CAL_SCHEDULING_URL=https://cal.com/yourname/30min
# API key from Cal.com settings (optional — used for programmatic booking creation)
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# ─── CRM (all optional — falls back to log-only mock) ─────────────────────────
# HubSpot — free CRM tier. Get API key at: https://app.hubspot.com/api-key
HUBSPOT_API_KEY=

# Salesforce — free developer org at: https://developer.salesforce.com/signup
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# Pipedrive — free 14-day trial. Get API key at: https://pipedrive.com
PIPEDRIVE_API_KEY=

# ─── Conversational channels (all optional — mocked when not configured) ──────
# Twilio SMS — $15 starter credit, ~$0.0075/SMS after
# Docs: https://www.twilio.com/docs/sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Unipile — LinkedIn DM bridge (paid, ~$49/mo for LinkedIn seat)
# Docs: https://developer.unipile.com
UNIPILE_API_KEY=

# ─── People Data Labs (alternative enrichment provider) ──────────────────────
# Free tier: 100 API calls/month. Sign up: https://www.peopledatalabs.com/
# To activate: set ENRICHMENT_PROVIDER=pdl
PDL_API_KEY=

# ─── Crunchbase (funding signals for intent scoring) ──────────────────────────
# Basic API: $29/month. Sign up: https://data.crunchbase.com/
# Without a key, deterministic mock signals are used (works great for demos)
CRUNCHBASE_API_KEY=

# ─── App base URL (tracking pixel embedding in emails) ────────────────────────
# Set to your deployed URL so open-tracking pixels resolve correctly.
# Leave blank in local dev — emails still send, pixels just won't embed.
APP_BASE_URL=https://your-app.railway.app

# ─── Webhook Security ──────────────────────────────────────────────────────────
# Shared secret validated on every /ingest/* endpoint via X-Webhook-Secret header.
# Leave empty in dev/demo mode (all ingest endpoints remain open).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# ─── Scheduler ─────────────────────────────────────────────────────────────────
# How long (seconds) a lead can sit in 'pending' before being auto-requeued.
AUTO_PROCESS_DELAY_SECONDS=60

# ─── CORS — Production Origins ─────────────────────────────────────────────────
# Comma-separated list of allowed origins for production deployments.
# Localhost regex is always active for dev. Leave empty locally.
# Example: ALLOWED_ORIGINS=https://sdr.mycompany.com,https://app.mycompany.com
ALLOWED_ORIGINS=

# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development

# ─── Email verification (pre-send deliverability gate) ────────────────────────
# Syntax + disposable-domain + role-account + MX checks run before any send;
# undeliverable addresses are skipped and hard bounces feed the suppression list.
EMAIL_VERIFICATION_ENABLED=true
# SMTP RCPT probe against the recipient's MX (port 25). Leave off unless your
# host allows outbound 25 — inconclusive results never block a send.
EMAIL_VERIFICATION_SMTP_PROBE=false
# Re-verify a lead's address after this many days (0 = trust forever)
EMAIL_VERIFICATION_TTL_DAYS=7

# ─── OAuth mailboxes (Gmail API / Microsoft Graph) ────────────────────────────
# For Google Workspace / Microsoft 365 tenants where app passwords are disabled.
# Google: create an OAuth client at https://console.cloud.google.com/apis/credentials
#   (enable the Gmail API; scopes: gmail.send, gmail.modify) and register
#   {APP_BASE_URL}/mailboxes/oauth/gmail/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: app registration at https://entra.microsoft.com (delegated
#   Mail.Send, Mail.ReadWrite, offline_access) with redirect URI
#   {APP_BASE_URL}/mailboxes/oauth/microsoft/callback.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows any tenant; pin to your tenant ID for single-tenant apps
MICROSOFT_TENANT_ID=common

# ─── CRM — HubSpot bidirectional sync ─────────────────────────────────────────
# OAuth app at developers.hubspot.com (scopes: crm.objects.contacts.read/write,
# crm.objects.deals.read). Redirect URI: {APP_BASE_URL}/crm/hubspot/callback.
# The client secret also validates webhook signatures — point your HubSpot app's
# webhook target at {APP_BASE_URL}/ingest/hubspot-webhook with subscriptions on
# contact.propertyChange (lifecyclestage) and deal.propertyChange (dealstage).
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ─── Prospecting ──────────────────────────────────────────────────────────────
# synthetic (default, deterministic demo) | pdl (Person Search, reuses PDL_API_KEY)
PROSPECTING_PROVIDER=synthetic
PROSPECTING_MAX_LEADS_PER_DAY=100
PROSPECTING_MIN_SCORE=0.3

# ─── Demo mode ────────────────────────────────────────────────────────────────
# Comma-separated emails whose sessions are read-only — safe to publish a demo
# login in the README.
DEMO_READONLY_EMAILS=
